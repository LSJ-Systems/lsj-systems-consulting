# Zoho API Integration Configuration
# Obtain credentials from Zoho API Console (https://api-console.zoho.com/)
# Required Scopes:
#   ZohoMail.organization.accounts.READ
#   ZohoMail.organization.accounts.UPDATE
#   ZohoMail.organization.accounts.CREATE

# OAuth Client Credentials
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# Zoho Data Center Accounts Domain
# Options: accounts.zoho.com (US), accounts.zoho.eu (EU), accounts.zoho.in (IN), accounts.zoho.com.au (AU), etc.
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.com

# Target Service: "mail" (default for Zoho Mail/Workplace mailbox) or "crm"
ZOHO_SERVICE=mail

# Zoho Mail specific (optional: if omitted, the script fetches the organization ZOID automatically)
# ZOHO_ZOID=123456789

# User / Contact Settings
USER_EMAIL=ryan.s.littleton@lsjsystems.com
USER_FIRST_NAME=Ryan
USER_LAST_NAME=Littleton
USER_PHONE=202-913-5204
NEW_USER_EMAIL=ryan.s.littleton@lsjsystems.com
NEW_USER_FIRST_NAME=Ryan
NEW_USER_LAST_NAME=Littleton
NEW_USER_PHONE=202-913-5204
# NEW_USER_PASSWORD=OptionalTemporaryPassword123!
